{
  "expo": {
    "name": "Obsidian",
    "newArchEnabled": true,
    "slug": "obsidian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.himanshu.obsidian",
      "infoPlist": {
        "NSCameraUsageDescription": "Image Vault uses the camera to capture photos that are encrypted immediately and never saved to your gallery.",
        "NSFaceIDUsageDescription": "Image Vault uses Face ID to unlock your vault.",
        "NSPhotoLibraryUsageDescription": "Image Vault needs access to your photo library to encrypt and decrypt images.",
        "NSPhotoLibraryAddUsageDescription": "Image Vault needs permission to save decrypted images to your photo library.",
        "buildNumber": "1"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.jpg",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.himanshu.obsidian",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "edgeToEdgeEnabled": true,
      "versionCode": 1
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Obsidian needs access to your photo library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Obsidian needs access to save decrypted images.",
          "savePhotosPermission": "Obsidian needs permission to save images to your library."
        }
      ],
      "expo-asset"
    ],
    "scheme": "obsidian",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "him4nshudevs-organization",
    "extra": {
      "eas": {
        "projectId": "51804e0f-ebe4-4edf-b82e-26cb9357462a"
      }
    }
  }
}
