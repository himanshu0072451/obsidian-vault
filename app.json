{
  "expo": {
    "name": "Obsidian",
    "slug": "obsidian",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "userInterfaceStyle": "dark",

    "icon": "./assets/expo-icons/icon.png",

    "splash": {
      "image": "./assets/expo-icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },

    "web": {
      "bundler": "metro"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.himanshu.obsidian",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Obsidian uses the camera to capture photos that are encrypted immediately and never saved to your gallery.",
        "NSFaceIDUsageDescription": "Obsidian uses Face ID to unlock your vault.",
        "NSPhotoLibraryUsageDescription": "Obsidian needs access to your photo library to encrypt images.",
        "NSPhotoLibraryAddUsageDescription": "Obsidian needs permission to save decrypted images to your photo library."
      }
    },

    "android": {
      "package": "com.himanshu.obsidian",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,

      "adaptiveIcon": {
        "foregroundImage": "./assets/expo-icons/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },

      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],

      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },

    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Obsidian needs access to your photo library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Obsidian needs access to save decrypted images.",
          "savePhotosPermission": "Obsidian needs permission to save images to your library."
        }
      ],
      "expo-asset"
    ],

    "scheme": "obsidian",

    "experiments": {
      "typedRoutes": true
    },

    "owner": "him4nshudevs-organization",

    "extra": {
      "eas": {
        "projectId": "51804e0f-ebe4-4edf-b82e-26cb9357462a"
      }
    }
  }
}
